rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cards collection
    match /cards/{cardId} {

      // Helper: card has an owner
      function hasOwner(doc) {
        return doc.data.ownerUserId != null && doc.data.ownerUserId != '';
      }

      // Read: allow if card is public (no owner) OR the requester is the owner
      allow get, list: if (
        !resource.exists ? true : (
          (!hasOwner(resource) ) || (request.auth != null && resource.data.ownerUserId == request.auth.uid)
        )
      );

      // Create: allow if request data is valid and ownerUserId (if present) matches auth.uid
      allow create: if (
        // Basic required fields — adjust to match your schema
        request.resource.data.keys().hasAll(['id','name','email','cardType','message','sendAt'])
        // If there's an authenticated user, ownerUserId (if set) must equal auth.uid
        && (
          request.auth != null
            ? (request.resource.data.ownerUserId == request.auth.uid)
            : (request.resource.data.ownerUserId == null || request.resource.data.ownerUserId == '')
        )
        // Basic types validation
        && request.resource.data.id is string
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.cardType is string
        && request.resource.data.message is string
        && request.resource.data.sendAt is string
      );

      // Update/delete: only owner can modify or delete their card
      allow update, delete: if (
        request.auth != null && resource.data.ownerUserId == request.auth.uid
      );
    }

    // Users collection (user profile + friends subcollection)
    match /users/{userId} {
      // Only the user (authenticated) may read or write their top-level document
      allow get, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if (request.auth != null && request.auth.uid == userId);

      // Friends subcollection under each user
      match /friends/{friendId} {
        // Only the owning user may read/write their friends documents
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny for all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
